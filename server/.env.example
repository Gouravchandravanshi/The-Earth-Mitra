PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/earth-mitra
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Earth Mitra <login@your-verified-domain.com>
CLIENT_URL=http://localhost:5173
# Optional comma-separated allowlist for multiple deployed frontends (store + admin).
# CLIENT_URLS=https://store.example.com,https://admin.example.com
# Optional inputs for `npm run create-admin`; remove these after creating the admin account.
# ADMIN_NAME=Store Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-unique-password
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Set to 1 only in a local or isolated development database to load sample product data.
SEED_DEMO_DATA=0
