# Merge the missing entries into server/.env. Keep credentials server-side.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Set false temporarily to accept checkout without Shiprocket serviceability or
# product parcel measurements. Admin dispatch still requires valid parcel details.
SHIPROCKET_CHECKOUT_CHECK_ENABLED=true
# Optional if exactly one active warehouse or a primary warehouse is returned.
# Prefer selecting a verified warehouse in Admin > Shipping & Tax.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Generate a random secret; set the same x-api-key in Shiprocket webhook settings.
SHIPROCKET_WEBHOOK_KEY=
PUBLIC_DELIVERY_CHECK_WEIGHT_KG=5
BUSINESS_NAME=Earth Mitra Farmers
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
